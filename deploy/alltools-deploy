#!/usr/bin/env bash
set -euo pipefail

readonly APP_ROOT="/opt/alltools"
readonly RELEASES_DIR="$APP_ROOT/releases"
readonly ENV_FILE="/etc/alltools/alltools.env"
readonly PROJECT_NAME="alltools"
# asr 必须一起纳入门控：它不被检查时，服务没起来而发布照样绿灯。
# asr 首次启动要下载模型、start_period 为 400s，所以把等待预算放到 600s。
readonly MAX_HEALTH_ATTEMPTS=120

release_id="${1:-}"
if [[ ! "$release_id" =~ ^[a-f0-9]{40}$ ]]; then
  echo "Expected a 40-character lowercase Git commit SHA." >&2
  exit 64
fi

release_dir="$RELEASES_DIR/$release_id"
if [[ ! -f "$release_dir/compose.yaml" || ! -f "$release_dir/Dockerfile" || ! -f "$release_dir/package-lock.json" ]]; then
  echo "Release $release_id is incomplete." >&2
  exit 65
fi

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE." >&2
  exit 66
fi

old_release_dir=""
old_release_id=""
if [[ -L "$APP_ROOT/current" ]]; then
  old_release_dir="$(readlink -f "$APP_ROOT/current")"
  old_release_id="${old_release_dir##*/}"
fi

compose=(env "RELEASE_ID=$release_id" docker compose --project-name "$PROJECT_NAME" --project-directory "$release_dir" --env-file "$ENV_FILE" -f "$release_dir/compose.yaml")
"${compose[@]}" config --quiet

# tunnel profile 由 /etc/alltools/alltools.env 的 COMPOSE_PROFILES=tunnel 启用。
# 启用时隧道连接器和它的回环网关必须过同样的健康门控：cloudflared 的
# healthcheck 打的是内置 /ready 端点，只有和 Cloudflare 边缘建立连接才算 healthy，
# 否则隧道挂了而发布照样绿灯。未启用 profile 时保持原有纯 HTTP 部署路径。
# 只保留 compose.yaml 里真实存在的服务：服务器环境可能残留已删除的 profile
#（如 rembg），config --services 会把它列出来，但 up 不会再创建该容器，
# 直接拿来做门控会误报 “no such service”。取交集即可兼容新旧环境。
mapfile -t available_services < <("${compose[@]}" config --services)
is_available() {
  local wanted="$1" s
  for s in "${available_services[@]}"; do
    [[ "$s" == "$wanted" ]] && return 0
  done
  return 1
}
services=()
for s in app gateway asr; do
  is_available "$s" && services+=("$s")
done
if is_available tunnel-gateway; then
  services+=(tunnel-gateway cloudflared)
fi

dump_logs() {
  for service in "${services[@]}"; do
    "${compose[@]}" logs --tail 100 "$service" >&2 || true
  done
}

restore_previous_release() {
  if [[ "$old_release_id" =~ ^[a-f0-9]{40}$ && -f "$old_release_dir/compose.yaml" ]]; then
    echo "Restoring previously healthy release $old_release_id." >&2
    env "RELEASE_ID=$old_release_id" docker compose \
      --project-name "$PROJECT_NAME" \
      --project-directory "$old_release_dir" \
      --env-file "$ENV_FILE" \
      -f "$old_release_dir/compose.yaml" \
      up --detach --no-build --remove-orphans >&2
  fi
}

if ! "${compose[@]}" up --detach --build --remove-orphans; then
  echo "docker compose up failed." >&2
  dump_logs
  restore_previous_release
  exit 68
fi

declare -A containers=()
for service in "${services[@]}"; do
  container_id="$("${compose[@]}" ps --quiet "$service")"
  if [[ -z "$container_id" ]]; then
    echo "The $service container was not created." >&2
    dump_logs
    restore_previous_release
    exit 67
  fi
  containers["$service"]="$container_id"
done

for ((attempt = 1; attempt <= MAX_HEALTH_ATTEMPTS; attempt += 1)); do
  all_healthy=true
  for service in "${services[@]}"; do
    health="$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}unknown{{end}}' "${containers[$service]}")"
    if [[ "$health" == "unhealthy" ]]; then
      all_healthy=false
      break 2
    fi
    if [[ "$health" != "healthy" ]]; then
      all_healthy=false
    fi
  done
  if [[ "$all_healthy" == true ]]; then
    ln -sfn "$release_dir" "$APP_ROOT/current"
    echo "Release $release_id is healthy."
    exit 0
  fi
  sleep 5
done

dump_logs
restore_previous_release
echo "Release $release_id did not become healthy." >&2
exit 68
