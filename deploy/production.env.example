# This value is compiled into metadata, canonical URLs, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://36.133.40.235:9999
ALLTOOLS_BIND_ADDRESS=0.0.0.0
ALLTOOLS_PORT=9999
MINERU_API_TOKEN=

# DeepSeek API key for AI tools (server-side only). Required for the AI PPT tool.
DEEPSEEK_API_KEY=
# Optional: per-IP daily generation limit for AI features. Defaults to 20 when unset.
# ALLTOOLS_AI_DAILY_LIMIT=20

# ASR (faster-whisper) model size for voice input: base (default) or small (better, more RAM)
# ASR_MODEL_SIZE=base

# Optional Cloudflare Tunnel. Set COMPOSE_PROFILES=tunnel to start tunnel-gateway
# and cloudflared; the connector token lives in /etc/alltools/cloudflared.token
# (chmod 640, owner root, group readable by UID 65532's group — see README).
# COMPOSE_PROFILES=tunnel
# NEXT_PUBLIC_SITE_URL=https://tools.duwu.me
# NEXT_PUBLIC_PRIVATE_QUERY_URL=https://tools.duwu.me/private-query
